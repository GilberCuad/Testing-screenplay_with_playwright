{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "lib": ["ES2019"],
    "outDir": "./lib",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "declaration": true,
    "pretty": true,
    "newLine": "lf",
    "allowSyntheticDefaultImports": true
  },
  "include": [
     "tests/**/*.ts",
     "src/**/*.ts"
   ],
  "exclude": [
    "node_modules",
    "lib",
    "target"
  ],
  "ts-node": {
    "files": true,
    "transpileOnly": true
  }
}